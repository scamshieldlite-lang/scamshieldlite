{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.43.93:3000",
        "EXPO_PUBLIC_FALLBACK_API_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://scamshieldlite-api.onrender.com",
        "EXPO_PUBLIC_FALLBACK_API_URL": "https://scamshieldlite-backend.up.railway.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://scamshieldlite-api.onrender.com",
        "EXPO_PUBLIC_FALLBACK_API_URL": "https://scamshieldlite-backend.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  },
  "extra": {
    "eas": {
      "projectId": "8ea49fa7-ba5b-42ec-b27f-484a00d89e60"
    }
  },
  "expo": {
    "android": {
      "package": "com.ibnballo.scamshieldlite"
    },
    "extra": {
      "eas": {
        "projectId": "8ea49fa7-ba5b-42ec-b27f-484a00d89e60"
      }
    }
  }
}
